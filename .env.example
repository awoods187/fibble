# Copy to .env.local and fill in. Never commit real values.
#
# Claude API: no key needed. Sign in once with the Anthropic CLI (`ant auth login`,
# choosing the fibble workspace); the SDK picks the login up automatically. Don't set
# ANTHROPIC_API_KEY: it would override the login. CI uses workload identity federation.
DATABASE_URL=
# Tavily web search, used by the lie-verification stage.
SEARCH_API_KEY=
