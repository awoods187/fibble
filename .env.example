# Copy to .env.local. Never commit real values.
#
# Best: keep secrets in 1Password and put only references here, e.g.
#   SEARCH_API_KEY="op://Private/fibble-tavily/credential"
# then run commands through `op run --env-file=.env.local -- …` (docs/hosting.md).
#
# Claude API: no key needed. Sign in once with the Anthropic CLI (`ant auth login`,
# choosing the fibble workspace); the SDK picks the login up automatically. Don't set
# ANTHROPIC_API_KEY: it would override the login. CI uses workload identity federation.

# The app's read-only database role (fibble_reader). Leave empty locally to use files.
DATABASE_URL=
# The publish job's role (fibble_publisher): insert and update, never delete.
DATABASE_URL_PUBLISHER=
# Tavily web search, used by the lie-verification stage.
SEARCH_API_KEY=
