{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["content-example/**", "tsconfig.base.json", "eslint.config.mjs", ".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
