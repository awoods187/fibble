{
  "name": "@fibble/pipeline",
  "version": "0.0.0",
  "private": true,
  "description": "Offline content pipeline: harvest, reword, generate lies, verify, assemble, dedupe, review. Stages 1 to 4 are built; 5 to 7 are typed stubs.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "harvest": "tsx scripts/harvest.ts",
    "reword": "tsx scripts/reword.ts",
    "verify": "tsx scripts/verify.ts",
    "generate-lies": "tsx scripts/generate-lies.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@fibble/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
