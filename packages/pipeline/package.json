{
  "name": "@fibble/pipeline",
  "version": "0.0.0",
  "private": true,
  "description": "Offline content pipeline: harvest, reword, generate lies, verify, assemble, review, build days, publish.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "harvest": "tsx scripts/harvest.ts",
    "reword": "tsx scripts/reword.ts",
    "verify": "tsx scripts/verify.ts",
    "generate-lies": "tsx scripts/generate-lies.ts",
    "rating": "tsx scripts/rating.ts",
    "rank-truths": "tsx scripts/rank-truths.ts",
    "assemble": "tsx scripts/assemble.ts",
    "publish-days": "tsx scripts/publish-days.ts",
    "review": "tsx scripts/review.ts",
    "build-days": "tsx scripts/build-days.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@fibble/db": "workspace:*",
    "@fibble/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
